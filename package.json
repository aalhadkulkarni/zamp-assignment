    "apps/*"
  ],
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0-alpha-2026-07-26",
    "concurrently": "^10.0.4"
  }
