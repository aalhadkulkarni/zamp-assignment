# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Required. agent-api will not start without it: an analysis is the product,
# and there is nothing to serve without somewhere to keep one.
#
# Any Postgres will do — it is only a connection string. Deployed, this is
# Render's own, linked to the service so Render supplies this variable. Locally,
# use that database's external connection string.
DATABASE_URL=postgres://user:password@host/database

# Return a recorded reply instead of calling Anthropic. On by default here so a
# fresh clone runs, and can be developed against, with no key and no spend.
# Set to false when you want real model calls.
USE_FIXTURES=true

# How long a fixture waits before answering, in milliseconds. A recording
# returns instantly, which hides the loading states a real call makes obvious.
# Defaults to 1000. The test suite sets it to 0.
# FIXTURE_DELAY_MS=1000

# Only needed when USE_FIXTURES is false.
# Get a key from https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
