# Copy to .env and fill in. .env is gitignored — never commit a real key.
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Where uploaded documents are written. Defaults to ./.data
# DATA_DIR=.data
